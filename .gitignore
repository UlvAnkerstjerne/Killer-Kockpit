# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit actual secrets
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp/

# frontend-audit generated snaps and config
design/_debug/
.frontend-audit.json

# local dev tool configs
.playwright-mcp/

# raw design reference images (tracked separately outside the repo)
UI - design/

# local debug screenshots dropped in repo root
/*.png
